# CivicProof AI Configuration
# Set your Gemini API key to enable live AI image verification.
# If left blank, CivicProof AI automatically activates DEMO MODE (clearly labeled sample results).
GEMINI_API_KEY=your_gemini_api_key_here

# Security Settings
JWT_SECRET=civicproof-super-secret-key-change-in-production-2026
DATABASE_URL=sqlite:///./backend/civicproof.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Settings
PORT=8000
HOST=127.0.0.1
